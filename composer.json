{
    "name": "kmorganisation/signori-sdk-laravel",
    "description": "Official Laravel package for the Signori e-signature API",
    "type": "library",
    "license": "MIT",
    "keywords": ["signori", "e-signature", "esign", "laravel", "pdf", "signing"],
    "homepage": "https://github.com/signori/signori-sdk-laravel",
    "authors": [
        {
            "name": "Signori",
            "email": "dev@signori.ai"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "kmorganisation/signori-sdk-php": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Signori\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Signori\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Signori\\Laravel\\SignoriServiceProvider"],
            "aliases": {
                "Signori": "Signori\\Laravel\\Facades\\Signori"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/kmorganisation/signori-sdk-php"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
